{
  "name": "musicfree-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @musicfree/web dev",
    "build": "pnpm --filter @musicfree/web build",
    "typecheck": "pnpm --filter @musicfree/core typecheck && pnpm --filter @musicfree/web typecheck",
    "build:cf": "pnpm build && node scripts/build-worker.mjs && mkdir -p packages/web/dist/plugins && cp plugins/*.js packages/web/dist/plugins/",
    "build:zip": "pnpm build && node scripts/build-cf-zip.mjs"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "esbuild": "0.21.5"
  }
}
