{
  "name": "whymusic",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @whymusic/web dev",
    "build": "pnpm --filter @whymusic/web build",
    "typecheck": "pnpm --filter @whymusic/web typecheck",
    "build:cf": "node scripts/build-cf.mjs",
    "build:zip": "node scripts/build-cf.mjs && node scripts/build-cf-zip.mjs",
    "deploy:cf": "pnpm build:cf && cd packages/web && wrangler pages deploy dist --project-name=whymusicweb --branch=main --commit-dirty=true"
  },
  "devDependencies": {
    "esbuild": "0.21.5"
  }
}
