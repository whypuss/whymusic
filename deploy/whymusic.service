[Unit]
Description=WhyMusic self-hosted server
Documentation=https://github.com/whypuss/musicweb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __WORKDIR__ / __NODE__ / __USER__ 由 deploy/install.sh 在安裝時填入
WorkingDirectory=__WORKDIR__
ExecStart=__NODE__ packages/web/scripts/server.mjs
EnvironmentFile=__ENVFILE__
User=__USER__
Restart=on-failure
RestartSec=3
# 收到 stop 時送 SIGTERM，server.mjs 會排空連線再退出（見進程健壯性那段）
KillSignal=SIGTERM
TimeoutStopSec=15

# 加固：這個服務只需要讀自己的目錄、對外連網，不需要別的權限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only 而非 true：repo 若 clone 在使用者家目錄（/home/xxx/…）底下，
# ProtectHome=true 會把 /home 藏成空的，服務 chdir 到 WorkingDirectory 直接
# 失敗（status=200/CHDIR）。read-only 讓 /home 可見可讀（能 chdir、讀 dist），
# 下面的 ReadWritePaths 再單獨開放工作目錄可寫（配對碼寫在 repo 的 .sync/）。
ProtectHome=read-only
ReadWritePaths=__WORKDIR__

[Install]
WantedBy=multi-user.target
