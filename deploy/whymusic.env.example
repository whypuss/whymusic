# WhyMusic 自架後端設定。全部可選，複製成 /etc/whymusic.env 後按需修改。
# install.sh 會自動建立這個檔並填入 BUILD_STAMP；其餘保持預設即可運作。

# 監聽埠。
PORT=8788

# 監聽位址。有反向代理（nginx 等）時設 127.0.0.1，讓 node 只收本機連線、
# 外界一律走反代 —— 否則有人繞過反代直接命中這個埠，反代上的限流/TLS 全被跳過。
# 沒有反代、想直接對外時才設 0.0.0.0。
HOST=127.0.0.1

# 有反向代理時設 1：讓限流讀 X-Forwarded-For 拿到真實來源 IP。
# 沒有反代卻設 1 是危險的 —— 任何人都能偽造該標頭繞過限流。
TRUST_PROXY=1

# /api/proxy 網域白名單（逗號分隔）。空＝不限制（允許任何公網 host）。
# 這個 app 支援貼任意第三方插件 URL，預設不限制；私有網段一律擋，不受此影響。
# 想鎖死只允許已知音源時才設，例如：
# PROXY_ALLOWED_HOSTS=gdstudio.xyz,music.126.net,126.net

# /api/proxy 每 IP 限流。容量＝可累積的突發次數，refill＝每秒回補（≈長期每秒上限）。
# 設 PROXY_RATE_CAPACITY=0 完全關閉限流（公開部署時不建議）。
PROXY_RATE_CAPACITY=60
PROXY_RATE_REFILL=5

# 建置戳記。install.sh 每次部署時會自動更新這一行，不必手動改。
# BUILD_STAMP=
