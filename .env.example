# MusicFree Web - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# ── Server ───────────────────────────────────────────────────────────
# Port the self-hosted backend listens on (serves both the built frontend
# and the API). Defaults to 8788.
# PORT=8788

# ── Audiomack OAuth（已不再是 WhyMusic 的子音源）────────────────────
# audiomack 因播放不穩已從子音源清單移除。這幾個變數只影響 server.mjs 仍保留的
# /api/search 與 /api/media 等舊端點，WhyMusic 本身不再用到。
# 若必須成對設定 —— key 與 secret 不成對會回 1003 Invalid signature，
# 而且只有播放壞、搜尋正常，很難聯想到是設定問題。不確定就整組不要設。
AUDIOMACK_SEARCH_CONSUMER_KEY=audiomack-js
AUDIOMACK_SEARCH_SECRET=f3ac5b086f3eab260520d8e3049561e6
AUDIOMACK_MEDIA_CONSUMER_KEY=audiomack-js
AUDIOMACK_MEDIA_SECRET=f3ac5b086f3eab260520d8e3049561e6

# ── WhyMusic (the single aggregated source shown in the UI) ─────────
# Sub-sources are fanned out in parallel and merged:
#   netease   — largest simplified-Chinese catalogue   (via GD upstream)
#   joox      — HK/TW traditional-Chinese, Canto live  (via GD upstream)
# Neither needs credentials.
#
# Deliberately excluded:
#   kuwo      upstream url endpoint always returns an empty string
#   bilibili  returns HTML — searchable but unplayable
#   YouTube   every client now requires PoToken/BotGuard
#   audiomack unstable playback: the URL resolves but often fails on the
#             client, and appears to be geo-restricted (same track behaves
#             differently from different CF edges). Tracks only it carries
#             have no fallback, so keeping it just means randomly hitting
#             songs that will not play.
# WHY_MUSIC_SOURCES=netease,joox
# WHY_MUSIC_BITRATE=320
# GD_API_URL=https://music-api.gdstudio.xyz/api.php

# ── Cloudflare (only needed for CF Pages deploy) ────────────────────
# CLOUDFLARE_API_TOKEN=cf_...
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# ── Local dev proxy (optional) ──────────────────────────────────────
# API_PROXY_URL=http://localhost:9000