# MusicFree Web - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# ── Server ───────────────────────────────────────────────────────────
# Port the self-hosted backend listens on (serves both the built frontend
# and the API). Defaults to 8788.
# PORT=8788

# ── Audiomack OAuth (audiomack sub-source of WhyMusic) ──────────────
# Used for the audiomack sub-source: search, media URL, and album tracks.
# Default: 'audiomack-js' (Audiomack public example, same as MusicFree plugin).
# Replace with your own Audiomack app credentials if you have them.
AUDIOMACK_SEARCH_CONSUMER_KEY=audiomack-js
AUDIOMACK_SEARCH_SECRET=f3ac5b086f3eab260520d8e3049561e6
AUDIOMACK_MEDIA_CONSUMER_KEY=audiomack-js
AUDIOMACK_MEDIA_SECRET=f3ac5b086f3eab260520d8e3049561e6

# ── WhyMusic (the single aggregated source shown in the UI) ─────────
# Sub-sources are fanned out in parallel and merged:
#   netease   — largest simplified-Chinese catalogue   (via GD upstream)
#   joox      — HK/TW traditional-Chinese, Canto live  (via GD upstream)
#   audiomack — Western indie / hip-hop / afrobeats    (own OAuth impl)
# netease/joox need no credentials; audiomack uses the keys above.
#
# Deliberately excluded (measured 2026-08-18): upstream 'kuwo' always returns
# an empty url and 'bilibili' returns HTML — both searchable but unplayable.
# YouTube is excluded too: every client now requires PoToken/BotGuard.
# WHY_MUSIC_SOURCES=netease,joox,audiomack
# WHY_MUSIC_BITRATE=320
# GD_API_URL=https://music-api.gdstudio.xyz/api.php

# ── Cloudflare (only needed for CF Pages deploy) ────────────────────
# CLOUDFLARE_API_TOKEN=cf_...
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# ── Local dev proxy (optional) ──────────────────────────────────────
# API_PROXY_URL=http://localhost:9000