# WhyMusic - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.
#
# Everything here is optional. A default deployment needs no credentials at all.

# ── Self-hosted backend (packages/web/scripts/server.mjs) ───────────
# Port it listens on (serves both the built frontend and the API).
# PORT=8788

# Where the music source plugins are served from (/plugins/*.js).
# Defaults to the repo's plugins/ directory.
# PLUGINS_DIR=/opt/musicweb/plugins

# Where device pairing codes are stored (the "換裝置" feature).
# Defaults to the repo's .sync/ directory. Codes expire after 24 hours.
# SYNC_DIR=/var/lib/whymusic/sync

# Build stamp reported by /api/version and shown on the 設置 page.
# Pass this when deploying built files to a machine that has no git working
# tree — otherwise the server reports "dev" and the page will wrongly warn
# that the frontend and backend versions disagree.
# BUILD_STAMP=abc1234 · 08-19 12:00

# ── WhyMusic (the single aggregated source shown in the UI) ─────────
# Sub-sources are fanned out in parallel and merged:
#   netease   — largest simplified-Chinese catalogue
#   joox      — HK/TW traditional-Chinese, Canto live versions
# Both go through the GD upstream. Neither needs credentials.
#
# These only affect the backend's own copy of the source logic; the plugin
# that runs in the browser has its own constants.
# WHY_MUSIC_SOURCES=netease,joox
# WHY_MUSIC_BITRATE=320
# GD_API_URL=https://music-api.gdstudio.xyz/api.php

# ── Cloudflare (only needed for CF Pages deploy) ────────────────────
# CLOUDFLARE_API_TOKEN=cf_...
# CLOUDFLARE_ACCOUNT_ID=your-account-id
