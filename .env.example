# MusicFree Web - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# ── Audiomack OAuth (search endpoint) ────────────────────────────────
# Consumer key used for the /api/search endpoint.
# Default: 'audiomack-js' (Audiomack public example, same as MusicFree plugin).
# Replace with your own Audiomack app credentials if you have them.
AUDIOMACK_SEARCH_CONSUMER_KEY=audiomack-js
AUDIOMACK_SEARCH_SECRET=f3ac5b086f3eab260520d8e3049561e6

# ── Audiomack OAuth (media / album / play endpoints) ────────────────
# Consumer key used for /api/media, /api/album, /api/play (Audiomack).
# Default: 'audiomack-js' (Audiomack public example, same as MusicFree plugin).
AUDIOMACK_MEDIA_CONSUMER_KEY=audiomack-js
AUDIOMACK_MEDIA_SECRET=f3ac5b086f3eab260520d8e3049561e6

# ── Cloudflare (only needed for CF Pages deploy) ────────────────────
# CLOUDFLARE_API_TOKEN=cf_...
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# ── Local dev proxy (optional) ──────────────────────────────────────
# API_PROXY_URL=http://localhost:9000